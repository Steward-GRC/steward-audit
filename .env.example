# Local development settings. Copy to .env (git-ignored) and load it in the
# run target, for example with `dotenv: ['.env']` in the Taskfile.
#
# Local dev logs everything in human-readable form. Cluster environments set
# their own level and always log JSON: dev cluster debug, qa/staging info,
# production error.
LOG_LEVEL=trace
LOG_FORMAT=console

# Postgres. MIGRATE_DSN is a direct connection for migrations when the
# runtime DSN goes through a transaction-pooling proxy; it defaults to
# DATABASE_DSN.
DATABASE_DSN=postgres://audit:audit@localhost:5432/audit?sslmode=disable
MIGRATE_DSN=
MIGRATIONS_DIR=migrations

# RabbitMQ, where the audit events arrive.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

GRPC_PORT=9090
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# The RFC 3161 time-stamp authority. Empty turns checkpoint anchoring off.
AUDIT_TSA_URL=
AUDIT_CHECKPOINT_INTERVAL=15m
AUDIT_CHECKPOINT_BATCH_SIZE=10000
